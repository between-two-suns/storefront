{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign step = product.metafields.custom.routine_step.value | default: '01 / 04'
  assign role = product.metafields.custom.routine_role.value | default: product.type
%}

<section class="bts-product" data-bts-product>
  <div class="bts-product__grid">
    <div class="bts-product__media">
      {% if product.featured_image != blank %}
        {{ product.featured_image | image_url: width: 1100 | image_tag: widths: '420,640,840,1100', sizes: '(max-width: 749px) 88vw, 52vw', loading: 'eager', alt: product.featured_image.alt }}
      {% else %}
        <span class="bts-pack bts-pack--reset" aria-hidden="true">{{ role | default: 'PRODUCT' }}</span>
      {% endif %}
    </div>

    <div class="bts-product__info">
      <p class="bts-product__step">{{ step }}{% if role != blank %} · {{ role | upcase }}{% endif %}</p>
      <h1 class="bts-display bts-product__title">{{ product.title }}</h1>

      {% if product.metafields.custom.core_proposition != blank %}
        <p class="bts-product__description">{{ product.metafields.custom.core_proposition.value }}</p>
      {% elsif product.description != blank %}
        <div class="bts-product__description">{{ product.description | strip_html | truncatewords: 28 }}</div>
      {% endif %}

      <div class="bts-product__buy">
        <span class="bts-product__price">{{ current_variant.price | money }}</span>

        {% form 'product', product, class: 'bts-product-form' %}
          {% if product.has_only_default_variant == false %}
            <label class="visually-hidden" for="Variant-{{ section.id }}">Variant</label>
            <select id="Variant-{{ section.id }}" name="id">
              {% for variant in product.variants %}
                <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {% endfor %}
            </select>
          {% else %}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {% endif %}
          <input type="hidden" name="quantity" value="1">
          <button class="bts-button bts-button--solid bts-button--wide" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}ADD TO BAG{% else %}SOLD OUT{% endif %} <span aria-hidden="true">→</span>
          </button>
        {% endform %}
      </div>

      <div class="bts-product__accordion">
        <details>
          <summary>PRODUCT DETAILS <span aria-hidden="true">+</span></summary>
          <div>
            {% if product.metafields.custom.product_details != blank %}
              {{ product.metafields.custom.product_details | metafield_tag }}
            {% else %}
              {{ product.description }}
            {% endif %}
          </div>
        </details>

        <details>
          <summary>INGREDIENTS <span aria-hidden="true">+</span></summary>
          <div>
            {% if product.metafields.custom.ingredients != blank %}
              {{ product.metafields.custom.ingredients | metafield_tag }}
            {% else %}
              Add the full INCI list to the product metafield <strong>custom.ingredients</strong>.
            {% endif %}
          </div>
        </details>

        <details>
          <summary>HOW TO USE <span aria-hidden="true">+</span></summary>
          <div>
            {% if product.metafields.custom.how_to_use != blank %}
              {{ product.metafields.custom.how_to_use | metafield_tag }}
            {% else %}
              Add usage instructions to <strong>custom.how_to_use</strong>.
            {% endif %}
          </div>
        </details>

        <details>
          <summary>SHIPPING & RETURNS <span aria-hidden="true">+</span></summary>
          <div>
            Delivery and returns information will be localized for Egypt at launch.
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BTS product",
  "settings": []
}
{% endschema %}
