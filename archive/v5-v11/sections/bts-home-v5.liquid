<section class="bts5" data-bts5>
  <section class="bts5-hero-shell" data-bts5-hero>
    <div class="bts5-hero-stage">
      <div class="bts5-world" aria-hidden="true">
        <div class="bts5-curtain bts5-curtain--left"></div>
        <div class="bts5-curtain bts5-curtain--right"></div>
      </div>

      <div class="bts5-hero-copy" data-bts5-hero-copy>
        <img class="bts5-mark" src="{{ 'bts-icon-ink.svg' | asset_url }}" width="28" height="31" alt="">
        <h1>
          <span>YOUR SKIN</span>
          <span>MOVES THROUGH</span>
          <span>A LOT.</span>
        </h1>
        <p>Climate-adapted skincare for life between environments.</p>

        <div class="bts5-stressors" aria-label="Environmental stressors">
          <span>SUN</span><span>DUST</span><span>POLLUTION</span><span>DRY AC</span><span>HUMIDITY</span>
        </div>

        <div class="bts5-actions">
          <a href="#routine">SHOP THE ROUTINE <span aria-hidden="true">→</span></a>
          <a href="{{ routes.all_products_collection_url }}">SHOP PRODUCTS</a>
        </div>
      </div>

      <div class="bts5-between" data-bts5-between aria-hidden="true">
        <img class="bts5-mark" src="{{ 'bts-icon-ink.svg' | asset_url }}" width="28" height="31" alt="">
        <p class="bts5-kicker">DIFFERENT PLACES. SAME YOU.</p>
        <h2><span>THE SPACE</span><span>BETWEEN.</span></h2>
        <p class="bts5-between__copy">Skin changes. So does your environment.</p>

        <div class="bts5-env-readout">
          <span data-bts5-env-index>01 / 05</span>
          <strong data-bts5-env-title>SUN</strong>
          <small data-bts5-env-copy>Stronger UV. Higher exposure.</small>
        </div>
      </div>

      <div class="bts5-env-nav" data-bts5-env-nav aria-label="Explore environments">
        <button type="button" data-env="sun" data-index="01 / 05" data-title="SUN" data-copy="Stronger UV. Higher exposure." aria-pressed="true">SUN</button>
        <button type="button" data-env="dust" data-index="02 / 05" data-title="DUST" data-copy="Fine particles. Constant contact." aria-pressed="false">DUST</button>
        <button type="button" data-env="pollution" data-index="03 / 05" data-title="POLLUTION" data-copy="Urban exposure. Particles and buildup." aria-pressed="false">POLLUTION</button>
        <button type="button" data-env="dry-ac" data-index="04 / 05" data-title="DRY AC" data-copy="Cooler air. Lower humidity." aria-pressed="false">DRY AC</button>
        <button type="button" data-env="humidity" data-index="05 / 05" data-title="HUMIDITY" data-copy="More moisture. Oil and comfort can shift." aria-pressed="false">HUMIDITY</button>
      </div>

      <div class="bts5-scroll-hint" aria-hidden="true">SCROLL TO EXPLORE ↓</div>
    </div>
  </section>

  <section class="bts5-story bts5-story--reset" data-bts5-reveal>
    <div class="bts5-story__copy">
      <div class="bts5-story__meta"><span>01 / 04</span><span>CLEANSE</span></div>
      <h2>RESET</h2>
      <h3>A FRESH START, ANYWHERE.</h3>
      <p>Removes oil, maintains hydration, and leaves skin feeling fresh.</p>
      <div class="bts5-pills"><span>OIL BALANCING</span><span>SOOTHES SKIN</span><span>NON-STRIPPING</span></div>
    </div>
    <div class="bts5-product-stage bts5-product-stage--reset">
      <div class="bts5-material bts5-material--reset" aria-hidden="true"></div>
      <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-reset-cleanser.jpg?v=1790626659" alt="BETWEEN TWO SUNS Daily Reset Cleanser" width="1024" height="1536" loading="lazy">
    </div>
  </section>

  <section class="bts5-story bts5-story--clarity" data-bts5-reveal>
    <div class="bts5-story__copy">
      <div class="bts5-story__meta"><span>02 / 04</span><span>TREAT</span></div>
      <h2>CLARITY</h2>
      <h3>SEE SKIN CLEARLY.</h3>
      <p>A focused daily serum step for a clearer-looking, more even appearance.</p>
      <div class="bts5-pills"><span>DAILY SERUM</span><span>LIGHTWEIGHT</span><span>ROUTINE STEP 02</span></div>
    </div>
    <div class="bts5-product-stage bts5-product-stage--clarity">
      <div class="bts5-material bts5-material--clarity" aria-hidden="true"></div>
      <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-clarity-serum.jpg?v=1790626663" alt="BETWEEN TWO SUNS Clarity Serum" width="1024" height="1536" loading="lazy">
    </div>
  </section>

  <section class="bts5-story bts5-story--barrier" data-bts5-reveal>
    <div class="bts5-story__copy">
      <div class="bts5-story__meta"><span>03 / 04</span><span>HYDRATE</span></div>
      <h2>BARRIER</h2>
      <h3>COMFORT THAT MOVES WITH YOU.</h3>
      <p>Daily moisture designed to support skin through changing environments.</p>
      <div class="bts5-pills"><span>LIGHTWEIGHT</span><span>DAILY MOISTURE</span><span>ROUTINE STEP 03</span></div>
    </div>
    <div class="bts5-product-stage bts5-product-stage--barrier">
      <div class="bts5-material bts5-material--barrier" aria-hidden="true"></div>
      <div class="bts5-membrane" aria-hidden="true"></div>
      <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-barrier-moisturizing-cream.jpg?v=1790626668" alt="BETWEEN TWO SUNS Daily Barrier Moisturizing Cream" width="1024" height="1536" loading="lazy">
    </div>
  </section>

  <section class="bts5-story bts5-story--defense" data-bts5-reveal>
    <div class="bts5-story__copy">
      <div class="bts5-story__meta"><span>04 / 04</span><span>PROTECT</span></div>
      <h2>DEFENSE</h2>
      <h3>READY FOR WHAT COMES NEXT.</h3>
      <p>SPF 50 protection for the final step of the morning routine.</p>
      <div class="bts5-pills"><span>SPF 50</span><span>UVA + UVB</span><span>AM STEP 04</span></div>
    </div>
    <div class="bts5-product-stage bts5-product-stage--defense">
      <div class="bts5-material bts5-material--defense" aria-hidden="true"></div>
      <div class="bts5-light" aria-hidden="true"></div>
      <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-defense-sunscreen-spf-50.jpg?v=1790626674" alt="BETWEEN TWO SUNS Daily Defense Sunscreen SPF 50" width="1024" height="1536" loading="lazy">
    </div>
  </section>

  <section id="routine" class="bts5-routine" data-bts5-routine data-time="am" data-bts5-reveal>
    <div class="bts5-routine__head">
      <p class="bts5-kicker">THE COMPLETE ROUTINE</p>
      <h2><span>YOUR ADAPTIVE</span><span>DAILY ROUTINE.</span></h2>
      <p>Four essentials. Every environment.</p>

      <div class="bts5-time" role="group" aria-label="Routine time">
        <button type="button" data-bts5-time="am" aria-pressed="true">AM <span>☀</span></button>
        <button type="button" data-bts5-time="pm" aria-pressed="false">PM <span>◐</span></button>
      </div>
    </div>

    <div class="bts5-lineup">
      <article data-bts5-step="reset">
        <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-reset-cleanser.jpg?v=1790626659" alt="Daily Reset Cleanser" width="1024" height="1536" loading="lazy">
        <div><span>01</span><strong>RESET</strong><small>CLEANSE</small></div>
      </article>
      <article data-bts5-step="clarity">
        <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-clarity-serum.jpg?v=1790626663" alt="Clarity Serum" width="1024" height="1536" loading="lazy">
        <div><span>02</span><strong>CLARITY</strong><small>TREAT</small></div>
      </article>
      <article data-bts5-step="barrier">
        <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-barrier-moisturizing-cream.jpg?v=1790626668" alt="Daily Barrier Moisturizing Cream" width="1024" height="1536" loading="lazy">
        <div><span>03</span><strong>BARRIER</strong><small>HYDRATE</small></div>
      </article>
      <article data-bts5-step="defense">
        <img src="https://cdn.shopify.com/s/files/1/0842/8122/9570/files/bts-daily-defense-sunscreen-spf-50.jpg?v=1790626674" alt="Daily Defense Sunscreen SPF 50" width="1024" height="1536" loading="lazy">
        <div><span>04</span><strong>DEFENSE</strong><small>PROTECT</small></div>
      </article>
    </div>

    <div class="bts5-routine-card">
      <div>
        <div>
          <span>COMPLETE ROUTINE</span>
          <strong data-bts5-count>4 STEPS · AM</strong>
        </div>
        <p>Built for life between environments.</p>
      </div>
      <button type="button" data-bts5-add>ADD COMPLETE ROUTINE <span aria-hidden="true">→</span></button>
    </div>
  </section>

  <section class="bts5-end">
    <img src="{{ 'bts-icon-ink.svg' | asset_url }}" width="32" height="35" alt="">
    <h2>fresh skin. always.</h2>
    <p>Climate-adapted skincare for life between environments.</p>
  </section>
</section>

{{ 'bts-home-v5.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bts-home-v5.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "BTS Home v5",
  "settings": [],
  "presets": [{"name": "BTS Home v5"}]
}
{% endschema %}
