<section class="bts-cart">
  <div class="bts-cart__inner">
    <p class="bts-kicker">YOUR BAG</p>
    <h1 class="bts-display bts-cart__title">{% if cart.empty? %}NOTHING BETWEEN YOU AND WHAT'S NEXT.{% else %}YOUR ROUTINE, IN PROGRESS.{% endif %}</h1>

    {% if cart.empty? %}
      <a class="bts-button bts-button--solid" href="{{ routes.all_products_collection_url }}">SHOP PRODUCTS <span aria-hidden="true">→</span></a>
    {% else %}
      {% form 'cart', cart %}
        <div class="bts-cart__items">
          {% for item in cart.items %}
            <div class="bts-cart__item">
              <a href="{{ item.url }}" aria-label="{{ item.product.title | escape }}">
                {% if item.image %}
                  {{ item.image | image_url: width: 220 | image_tag: widths: '84,168,220', loading: 'lazy', alt: item.image.alt }}
                {% endif %}
              </a>

              <div>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {% unless item.variant.title == 'Default Title' %}<small>{{ item.variant.title }}</small>{% endunless %}
                <small>{{ item.final_line_price | money }}</small>
              </div>

              <label>
                <span class="visually-hidden">Quantity for {{ item.product.title }}</span>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" style="width:54px">
              </label>
            </div>
          {% endfor %}
        </div>

        <div class="bts-cart__summary">
          <div class="bts-cart__subtotal">
            <span>SUBTOTAL</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <button class="bts-button bts-button--wide" type="submit" name="update">UPDATE BAG</button>
          <button class="bts-button bts-button--solid bts-button--wide" type="submit" name="checkout">CHECKOUT <span aria-hidden="true">→</span></button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "BTS cart",
  "settings": []
}
{% endschema %}
