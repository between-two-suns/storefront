{% doc %}
Catalog identities for the prototype adapter; draft-safe display only.
{% enddoc %}
{% capture product_handles %}{% render 'bts-product-handles' %}{% endcapture %}{% assign product_handles = product_handles | strip %}
{% assign product_handles = product_handles | append: '|the-full-routine' %}
{% assign handles = product_handles | split: '|' %}
<script type="application/json" id="bts-catalog">{
{% for handle in handles %}
  {% assign content = metaobjects.bts_product_content[handle] %}
  {% capture name %}{% render 'bts-content-field', content: content, handle: handle, field: 'name' %}{% endcapture %}{% assign name = name | strip %}
  {% capture role %}{% render 'bts-content-field', content: content, handle: handle, field: 'role' %}{% endcapture %}{% assign role = role | strip %}
  {% capture size %}{% render 'bts-content-field', content: content, handle: handle, field: 'size_display' %}{% endcapture %}{% assign size = size | strip %}
  {% capture colour %}{% render 'bts-content-field', content: content, handle: handle, field: 'colour_key' %}{% endcapture %}{% assign colour = colour | strip %}
  {% capture step %}{% render 'bts-content-field', content: content, handle: handle, field: 'step' %}{% endcapture %}{% assign step = step | strip %}
  {{ handle | json }}: {"name": {{ name | json }}, "role": {{ role | json }}, "size": {{ size | json }}, "colour": {{ colour | json }}, "step": {{ step | plus: 0 | json }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
}</script>
