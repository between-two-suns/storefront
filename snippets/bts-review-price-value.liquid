{% doc %}
Scenario-derived review display value; does not set any Shopify price.
@param {string} [handle] - Product identity or routine
@param {string} [field] - routine_list, routine_save, currency, or config_json
{% enddoc %}
{%- liquid
  assign config = metaobjects.bts_prototype_config.default.config.value
  assign scenario = config.scenarios[config.scenario]
-%}
{%- if config != blank -%}
  {%- case field -%}
    {%- when 'config_json' -%}{{- config | json -}}
    {%- when 'currency' -%}{{- config.currency -}}
    {%- when 'routine_list' -%}{{- scenario.routine.list -}}
    {%- when 'routine_save' -%}{{- scenario.routine.save -}}
    {%- else -%}{%- if handle == 'the-full-routine' -%}{{- scenario.routine.price -}}{%- else -%}{{- scenario.prices[handle] -}}{%- endif -%}
  {%- endcase -%}
{%- elsif settings.bts_review_fallback == true -%}
  {%- case field -%}
    {%- when 'config_json' -%}{"scenario":"B","currency":"EGP","scenarios":{"A":{"prices":{"daily-reset-cleanser":349,"clarity-serum":449,"daily-barrier-moisturizing-cream":399,"daily-defense-sunscreen-spf-50":449},"routine":{"list":1646,"price":1481,"save":165,"save_pct":10}},"B":{"prices":{"daily-reset-cleanser":399,"clarity-serum":499,"daily-barrier-moisturizing-cream":449,"daily-defense-sunscreen-spf-50":499},"routine":{"list":1846,"price":1661,"save":185,"save_pct":10}}}}
    {%- when 'currency' -%}EGP
    {%- when 'routine_list' -%}1846
    {%- when 'routine_save' -%}185
    {%- else -%}{%- case handle -%}
      {%- when 'daily-reset-cleanser' -%}399
      {%- when 'clarity-serum' -%}499
      {%- when 'daily-barrier-moisturizing-cream' -%}449
      {%- when 'daily-defense-sunscreen-spf-50' -%}499
      {%- when 'the-full-routine' -%}1661
    {%- endcase -%}
  {%- endcase -%}
{%- endif -%}
