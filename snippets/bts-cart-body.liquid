<div class="bts-cart" data-bts-cart>
  <div class="bts-cart__empty" data-bts-empty><p>{{ 'bts.empty' | t }}</p><a href="{{ routes.all_products_collection_url }}">{{ 'bts.shop' | t }} <span aria-hidden="true">↗</span></a></div>
  <ul class="bts-cart-lines" data-bts-lines></ul>
  <template data-bts-line>
    <li class="bts-cart-line">
      <span class="bts-cart-line__chip bts-cap" data-chip><img data-line-image hidden width="120" height="160" alt=""></span>
      <div class="bts-cart-line__body">
        <div class="bts-cart-line__top"><div><bdi lang="en" data-title></bdi><span class="bts-cart-line__meta" data-meta></span></div><bdi class="bts-cart-line__price" data-line-total></bdi></div>
        <div class="bts-cart-line__controls"><label><span class="bts-visually-hidden">{{ 'bts.quantity' | t }}</span><input type="number" min="0" inputmode="numeric" data-qty></label><button type="button" data-remove>{{ 'bts.remove' | t }}</button></div>
      </div>
    </li>
  </template>
  <div class="bts-cart__summary">
    <p data-bts-saving hidden>{{ 'bts.save' | t }} <bdi data-bts-saving-amount></bdi></p>
    <div class="bts-cart__total"><span>{{ 'bts.subtotal' | t }}</span><bdi data-bts-total>—</bdi></div>
    <p role="status" aria-live="polite" data-bts-status data-error="{{ 'bts.error' | t | escape }}"></p>
    <button class="bts-cart__checkout" type="button" disabled>{{ 'bts.checkout' | t }}</button>
  </div>
  <noscript><p>{{ 'bts.no_js' | t }}</p></noscript>
</div>