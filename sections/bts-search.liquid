{{ 'bts-face.css' | asset_url | stylesheet_tag }}
<section class="bts-foundation">
  <h1>{{ 'bts.search' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="BtsSearch-{{ section.id }}">{{ 'bts.search' | t }}</label>
    <input id="BtsSearch-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}">
    <button type="submit">{{ 'bts.search' | t }}</button>
  </form>
  {% assign term = search.terms | downcase | strip %}
  {% assign matches = 0 %}
  {% capture product_handles %}{% render 'bts-product-handles' %}{% endcapture %}{% assign product_handles = product_handles | strip %}{% assign products = product_handles | split: '|' %}
  {% for handle in products %}{% assign content = metaobjects.bts_product_content[handle] %}{% capture name %}{% render 'bts-content-field', content: content, handle: handle, field: 'name' %}{% endcapture %}{% assign name = name | strip %}
{% assign name = name | downcase %}
    {% if name != blank and term != blank and name contains term %}
      {% assign matches = matches | plus: 1 %}
      {% assign uid = section.id | append: '-' | append: forloop.index %}
      {% render 'bts-face', content: content, handle: handle, variant: 'search', uid: uid %}
    {% endif %}
  {% endfor %}
  {% if term != blank and matches == 0 %}<p>{{ 'bts.no_results' | t }}</p>{% endif %}
  {% render 'bts-routine-offer', uid: section.id, sheet: true %}
</section>
{% schema %}
{"name":"Prototype catalog search","settings":[]}
{% endschema %}
