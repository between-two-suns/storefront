{% liquid
  assign reset_product = section.settings.product_1
  assign clarity_product = section.settings.product_2
  assign barrier_product = section.settings.product_3
  assign defense_product = section.settings.product_4

  if reset_product == blank
    assign reset_product = all_products['daily-reset-cleanser']
  endif
  if clarity_product == blank
    assign clarity_product = all_products['clarity-serum']
  endif
  if barrier_product == blank
    assign barrier_product = all_products['daily-barrier-moisturizing-cream']
  endif
  if defense_product == blank
    assign defense_product = all_products['daily-defense-sunscreen-spf-50']
  endif
%}

<section
  class="bts-experience bts-experience--v3"
  data-bts-experience
  style="
    --bts-bg: {{ settings.color_background | default: '#F4F0E8' }};
    --bts-ink: {{ settings.color_ink | default: '#111111' }};
    --bts-mint: {{ settings.color_mint | default: '#8DDAB2' }};
    --bts-blue: {{ settings.color_blue | default: '#A6DDED' }};
    --bts-lilac: {{ settings.color_lilac | default: '#C9A8DB' }};
    --bts-peach: {{ settings.color_peach | default: '#F2A07D' }};
  "
>
  <section class="bts-v3-hero" data-bts-hero>
    <div class="bts-v3-aperture" aria-hidden="true">
      <div class="bts-v3-form bts-v3-form--left"></div>
      <div class="bts-v3-form bts-v3-form--right"></div>
    </div>

    <div class="bts-v3-hero__inner">
      <p class="bts-kicker">CLIMATE-ADAPTED SKINCARE</p>
      <h1 class="bts-display bts-v3-hero__title">
        <span>YOUR SKIN</span>
        <span>LIVES</span>
        <span>BETWEEN.</span>
      </h1>
      <p class="bts-v3-hero__sub">For life between environments.</p>

      <div class="bts-v3-hero__actions">
        <a class="bts-button bts-button--solid" href="#routine">SHOP THE ROUTINE <span aria-hidden="true">→</span></a>
        <a class="bts-text-link" href="{{ routes.all_products_collection_url }}">SHOP PRODUCTS</a>
      </div>
    </div>

    <div class="bts-v3-hero__signature">
      <span>fresh skin. always.</span>
      <img src="{{ 'bts-icon-ink.svg' | asset_url }}" width="28" height="31" alt="" loading="eager">
    </div>
  </section>

  <section id="environment" class="bts-v3-environment" data-bts-environment data-env="sun">
    <div class="bts-v3-environment__visual" aria-hidden="true">
      <div class="bts-v3-env-form bts-v3-env-form--left"></div>
      <div class="bts-v3-env-form bts-v3-env-form--right"></div>
    </div>

    <div class="bts-v3-environment__inner">
      <div class="bts-v3-environment__intro">
        <p class="bts-kicker">WHY CLIMATE-ADAPTED</p>
        <h2 class="bts-display">
          <span>THE WORLD CHANGES.</span>
          <span>YOUR SKIN ADAPTS.</span>
        </h2>
        <p>Sun. Dust. Pollution. Dry AC. Humidity. The conditions around you keep changing — your routine should be built for that reality.</p>
      </div>

      <div class="bts-v3-environment__state" aria-live="polite">
        <div class="bts-v3-environment__mark">
          <img src="{{ 'bts-icon-ink.svg' | asset_url }}" width="26" height="29" alt="">
        </div>
        <div>
          <span class="bts-v3-environment__index" data-env-index>01 / 05</span>
          <strong data-env-title>SUN</strong>
          <p data-env-copy>Stronger UV. Higher exposure.</p>
        </div>
      </div>

      <div class="bts-v3-environment__nav" role="group" aria-label="Environmental states">
        <button type="button" data-env-button="sun" data-index="01 / 05" data-title="SUN" data-copy="Stronger UV. Higher exposure." aria-pressed="true">SUN</button>
        <button type="button" data-env-button="dust" data-index="02 / 05" data-title="DUST" data-copy="Fine particles. Constant contact." aria-pressed="false">DUST</button>
        <button type="button" data-env-button="pollution" data-index="03 / 05" data-title="POLLUTION" data-copy="Urban exposure. Particles and buildup." aria-pressed="false">POLLUTION</button>
        <button type="button" data-env-button="dry-ac" data-index="04 / 05" data-title="DRY AC" data-copy="Cooler air. Lower humidity." aria-pressed="false">DRY AC</button>
        <button type="button" data-env-button="humidity" data-index="05 / 05" data-title="HUMIDITY" data-copy="More moisture. Oil and comfort can shift." aria-pressed="false">HUMIDITY</button>
      </div>
    </div>
  </section>

  <section id="routine" class="bts-v3-routine" data-bts-routine data-time="am">
    <div class="bts-v3-routine__head">
      <p class="bts-kicker">THE COMPLETE ROUTINE</p>
      <h2 class="bts-display">
        <span>YOUR ADAPTIVE</span>
        <span>DAILY ROUTINE.</span>
      </h2>
      <p>Four essentials. Built for life between environments.</p>

      <div class="bts-time-toggle" role="group" aria-label="Routine time">
        <button type="button" data-time-button="am" aria-pressed="true">AM <span aria-hidden="true">☀</span></button>
        <button type="button" data-time-button="pm" aria-pressed="false">PM <span aria-hidden="true">◐</span></button>
      </div>
    </div>

    <div class="bts-v3-routine__path" aria-label="Routine steps">
      <span class="bts-v3-routine__line" aria-hidden="true"></span>

      <article class="bts-v3-step bts-v3-step--reset" data-routine-item data-time="am,pm" data-step="01" data-variant-id="{% if reset_product != blank %}{{ reset_product.selected_or_first_available_variant.id }}{% endif %}">
        <a href="{% if reset_product != blank %}{{ reset_product.url }}{% else %}#{% endif %}">
          <span class="bts-v3-step__number">01</span>
          <span class="bts-v3-step__dot"></span>
          <span class="bts-v3-step__role">CLEANSE</span>
          <strong>{% if reset_product != blank %}{{ reset_product.title }}{% else %}Daily Reset Cleanser{% endif %}</strong>
        </a>
      </article>

      <article class="bts-v3-step bts-v3-step--clarity" data-routine-item data-time="am,pm" data-step="02" data-variant-id="{% if clarity_product != blank %}{{ clarity_product.selected_or_first_available_variant.id }}{% endif %}">
        <a href="{% if clarity_product != blank %}{{ clarity_product.url }}{% else %}#{% endif %}">
          <span class="bts-v3-step__number">02</span>
          <span class="bts-v3-step__dot"></span>
          <span class="bts-v3-step__role">TREAT</span>
          <strong>{% if clarity_product != blank %}{{ clarity_product.title }}{% else %}Clarity Serum{% endif %}</strong>
        </a>
      </article>

      <article class="bts-v3-step bts-v3-step--barrier" data-routine-item data-time="am,pm" data-step="03" data-variant-id="{% if barrier_product != blank %}{{ barrier_product.selected_or_first_available_variant.id }}{% endif %}">
        <a href="{% if barrier_product != blank %}{{ barrier_product.url }}{% else %}#{% endif %}">
          <span class="bts-v3-step__number">03</span>
          <span class="bts-v3-step__dot"></span>
          <span class="bts-v3-step__role">HYDRATE</span>
          <strong>{% if barrier_product != blank %}{{ barrier_product.title }}{% else %}Daily Barrier Moisturizing Cream{% endif %}</strong>
        </a>
      </article>

      <article class="bts-v3-step bts-v3-step--defense" data-routine-item data-time="am" data-defense data-step="04" data-variant-id="{% if defense_product != blank %}{{ defense_product.selected_or_first_available_variant.id }}{% endif %}">
        <a href="{% if defense_product != blank %}{{ defense_product.url }}{% else %}#{% endif %}">
          <span class="bts-v3-step__number">04</span>
          <span class="bts-v3-step__dot"></span>
          <span class="bts-v3-step__role">PROTECT</span>
          <strong>{% if defense_product != blank %}{{ defense_product.title }}{% else %}Daily Defense Sunscreen SPF 50{% endif %}</strong>
        </a>
      </article>
    </div>

    <div class="bts-v3-routine__commerce">
      <div class="bts-v3-routine__summary">
        <strong data-routine-count>4 STEPS · AM</strong>
        <span>One routine. Changing environments.</span>
      </div>
      <button
        class="bts-button bts-button--solid bts-button--wide"
        type="button"
        data-bts-add-routine
        {% unless reset_product != blank and clarity_product != blank and barrier_product != blank and defense_product != blank %}disabled{% endunless %}
      >
        ADD COMPLETE ROUTINE <span aria-hidden="true">→</span>
      </button>
    </div>
  </section>

  <section class="bts-v3-close">
    <div class="bts-v3-close__forms" aria-hidden="true">
      <div></div><div></div>
    </div>
    <div class="bts-v3-close__inner">
      <img src="{{ 'bts-icon-ink.svg' | asset_url }}" width="30" height="33" alt="">
      <p class="bts-kicker">BETWEEN TWO SUNS</p>
      <h2 class="bts-display">
        <span>READY FOR</span>
        <span>WHAT COMES NEXT.</span>
      </h2>
      <p>Climate-adapted skincare for everyday change.</p>
      <a class="bts-text-link" href="{{ routes.all_products_collection_url }}">EXPLORE THE RANGE</a>
    </div>
  </section>
</section>

{% schema %}
{
  "name": "BTS signature experience",
  "settings": [
    {
      "type": "header",
      "content": "Routine products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "01 — Daily Reset Cleanser"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "02 — Clarity Serum"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "03 — Daily Barrier Moisturizing Cream"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "04 — Daily Defense Sunscreen SPF 50"
    }
  ],
  "presets": [
    {
      "name": "BTS signature experience"
    }
  ]
}
{% endschema %}
