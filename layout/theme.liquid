<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#F4F0E8' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}
      {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} – Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} – {{ shop.name }}{% endunless -%}
    </title>
    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Gothic&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    {{ 'bts.css' | asset_url | stylesheet_tag: preload: true }}
    <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
  </head>
  <body class="template-{{ template.name | handle }}">
    <a class="bts-skip-link" href="#MainContent">Skip to content</a>
    {% section 'bts-header' %}
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'bts-footer' %}
    <script src="{{ 'bts.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
